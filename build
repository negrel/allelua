#!/usr/bin/env bash

set -euo pipefail

: ${CC:=clang}
CFLAGS="-Wall -Wextra -Werror -Wnull-dereference -Wformat=2
-Wshadow -Wsign-conversion -Wfloat-equal -Wswitch-enum -Wmissing-prototypes
-Wdeprecated-declarations -fsanitize=undefined -fsanitize=thread -std=c11
-I$EVENTLOOP_INCLUDE -I$LUAJIT_INCLUDE -I. -DEVENTLOOP_THREADPOOL"
LDFLAGS="-lpthread $(pkg-config --libs luajit)"

cc() {
	echo "CC	$@"
	$CC $CFLAGS $LDFLAGS $@
}

embed() {
	local in="$1"
	local out="$2"
	local name="$(basename ${out%.*})"
	echo "EMBED	$in"
	xxd -name "$name" -i "$in" > "$out"
}

execute() {
	echo "EXEC	$@"
	$@
	echo "exit code $?"
}

case "${1:-run}" in
	run)
		shift
		mkdir -p src/embed

		embed src/holylib/00_string.lua src/embed/holy_string.h
		embed src/holylib/00_table.lua src/embed/holy_table.h
		cc src/allelua.c cmd/allelua/run.c cmd/allelua/main.c -o allelua
		execute ./allelua $@
		;;

	compile_flags.txt)
		echo $CFLAGS -Isrc/ -I. -I$EVENTLOOP_INCLUDE \
			| tr ' ' '\n' > compile_flags.txt
		;;

	*)
		echo "unknown command: '${1-}'" >&2
		exit 1
		;;
esac

